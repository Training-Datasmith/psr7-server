{
    "name": "nyholm/psr7-server",
    "description": "Helper classes to handle PSR-7 server requests",
    "license": "MIT",
    "keywords": [
        "psr-7",
        "psr-17"
    ],
    "homepage": "http://tnyholm.se",
    "authors": [
        {
            "name": "Tobias Nyholm",
            "email": "tobias.nyholm@gmail.com"
        },
        {
            "name": "Martijn van der Ven",
            "email": "martijn@vanderven.se"
        }
    ],
    "repositories": {
        "0": {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    },
    "require": {
        "php": "^7.1 || ^8.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-factory": "dev-remote-test-2026-10-07 as 1.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.52",
        "psr/http-message": "dev-remote-test-2026-10-07 as 2.0.0",
        "nyholm/psr7": "dev-remote-test-2026-11-09 as 1.8.2",
        "nyholm/nsa": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Nyholm\\Psr7Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Nyholm\\Psr7Server\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php scripts/check-rename.php",
            "@php scripts/check-cluster-pins.php",
            "php -d error_reporting=32767 vendor/bin/phpunit --colors=never --no-coverage"
        ],
        "test-ci": "vendor/bin/phpunit --colors=never --coverage-text --coverage-clover=build/coverage.xml"
    }
}
